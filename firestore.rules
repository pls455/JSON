rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'Karamhahhss1@gmail.com';
    }

    match /branches/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subjects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lessons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quizzes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}